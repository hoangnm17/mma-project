{
  "MealAssistants": {
    "id": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "birthYear": {
      "type": "number",
      "required": true
    },
    "height": {
      "type": "number",
      "required": true
    },
    "bust": {
      "type": "number",
      "required": true
    },
    "waist": {
      "type": "number",
      "required": true
    },
    "hips": {
      "type": "number",
      "required": true
    },
    "weight": {
      "type": "number",
      "required": true
    },
    "photo": {
      "type": "string",
      "required": false,
      "default": null
    },
    "status": {
      "type": "string",
      "required": true,
      "default": "AVAILABLE"
    },
    "deleted": {
      "type": "bool",
      "required": true,
      "default": false
    },
    "updatedAt": {
      "type": "date",
      "required": true,
      "default": "$now"
    }
  },
  "Orders": {
    "mealAssistantId": {
      "type": "string",
      "required": false,
      "default": null,
      "ref": [
        "MealAssistants",
        "id"
      ]
    },
    "mealAssistantName": {
      "type": "string",
      "required": false,
      "default": null
    },
    "id": {
      "type": "string",
      "required": true
    },
    "kind": {
      "type": "string",
      "required": true
    },
    "specialPurpose": {
      "type": "string",
      "required": false,
      "default": null
    },
    "stayId": {
      "type": "string",
      "required": true,
      "ref": [
        "Stays",
        "id"
      ]
    },
    "status": {
      "type": "string",
      "required": true,
      "default": "PENDING"
    },
    "itemsJson": {
      "type": "string",
      "required": true
    },
    "total": {
      "type": "number",
      "required": true
    },
    "notes": {
      "type": "string",
      "required": true,
      "default": ""
    },
    "createdBy": {
      "type": "string",
      "required": true,
      "ref": [
        "Users",
        "id"
      ]
    },
    "requestedAt": {
      "type": "date",
      "required": true,
      "default": "$now"
    },
    "startedAt": {
      "type": "date",
      "required": false,
      "default": null
    },
    "completedAt": {
      "type": "date",
      "required": false,
      "default": null
    },
    "cancelledAt": {
      "type": "date",
      "required": false,
      "default": null
    },
    "updatedAt": {
      "type": "date",
      "required": true,
      "default": "$now"
    }
  }
}
