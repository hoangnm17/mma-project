{
  "name": "stayflow-project",
  "version": "1.0.2",
  "private": true,
  "description": "StayFlow backend and Expo mobile frontend",
  "scripts": {
    "setup": "npm --prefix frontend ci && npm --prefix backend ci",
    "start": "npm --prefix frontend start",
    "android": "npm --prefix frontend run android",
    "web": "npm --prefix frontend run web",
    "dev:frontend": "npm --prefix frontend start",
    "dev:backend": "npm --prefix backend run dev",
    "lint": "node frontend/node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix backend test",
    "test:integration": "npm --prefix backend run test:integration",
    "test:integration:local": "node backend/scripts/test-local-mongo.js",
    "test:ui": "node scripts/verify-ui.cjs",
    "export:android": "npm --prefix frontend run export:android",
    "export:web": "npm --prefix frontend run export:web",
    "build:apk": "npm --prefix frontend run build:apk"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
