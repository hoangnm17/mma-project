{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "es2022"
  },
  "include": ["src/**/*.js", "src/**/*.jsx", "shared/**/*.js"],
  "exclude": ["node_modules", "backend", "dist"]
}
